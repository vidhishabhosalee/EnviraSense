# Copy to .env — all values are optional; defaults match the deployed build.
VITE_SUPABASE_URL=https://geohnjcwlegsnoykalsg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx   # publishable/anon key ONLY — never the service-role key
VITE_NODE_LOCATIONS=NODE-001:19.0728:72.8826:Mumbai Lab   # fallback when the `nodes` table has no row for a node
VITE_CDSE_INSTANCE_ID=                # Copernicus Sentinel Hub instance id (comma-separate several)
VITE_OGD_API_KEY=                     # optional: your data.gov.in key (better: set OGD_API_KEY as a secret on the cpcb-proxy Edge Function)
VITE_OGD_BASE=                        # leave empty to use the cpcb-proxy Edge Function; set to /ogd only if your host rewrites /ogd → api.data.gov.in
VITE_API_BASE_URL=                    # optional REST backend (unused when Supabase is configured)
VITE_OFFLINE_AFTER_MIN=15                # a node shows LIVE only if it sent a reading within this many minutes
