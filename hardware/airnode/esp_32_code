#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BME680.h>
#include <ArduinoJson.h>
#include <driver/i2s.h>
#include <math.h>

#define PIN_SDA      21
#define PIN_SCL      22

#define PIN_I2S_SCK  14
#define PIN_I2S_WS   15
#define PIN_I2S_SD   32

#define NODE_ID          "NODE-001"
#define SAMPLE_MS        5000UL
#define SEA_LEVEL_HPA    1013.25f

#define I2S_SAMPLE_RATE  16000
#define I2S_SAMPLES      1024

#define MIC_OFFSET_DB    94.0f
#define MIC_REF_DBFS     -26.0f

// UART to Heltec LoRa transmitter
HardwareSerial LoRaSerial(2);

Adafruit_BME680 bme;

bool bmeFound = false;

int32_t i2sBuf[I2S_SAMPLES];


// =========================
// INMP441 SETUP
// =========================

void setupMic() {

  i2s_config_t cfg = {};

  cfg.mode = (i2s_mode_t)(
    I2S_MODE_MASTER |
    I2S_MODE_RX
  );

  cfg.sample_rate = I2S_SAMPLE_RATE;

  cfg.bits_per_sample =
    I2S_BITS_PER_SAMPLE_32BIT;

  cfg.channel_format =
    I2S_CHANNEL_FMT_ONLY_LEFT;

  cfg.communication_format =
    I2S_COMM_FORMAT_STAND_I2S;

  cfg.intr_alloc_flags =
    ESP_INTR_FLAG_LEVEL1;

  cfg.dma_buf_count = 4;
  cfg.dma_buf_len = 256;

  i2s_pin_config_t pins = {};

  pins.bck_io_num = PIN_I2S_SCK;
  pins.ws_io_num  = PIN_I2S_WS;

  pins.data_out_num =
    I2S_PIN_NO_CHANGE;

  pins.data_in_num =
    PIN_I2S_SD;

  i2s_driver_install(
    I2S_NUM_0,
    &cfg,
    0,
    NULL
  );

  i2s_set_pin(
    I2S_NUM_0,
    &pins
  );

  i2s_zero_dma_buffer(
    I2S_NUM_0
  );
}


// =========================
// READ NOISE LEVEL
// =========================

float readNoiseDb() {

  size_t got = 0;

  i2s_read(
    I2S_NUM_0,
    i2sBuf,
    sizeof(i2sBuf),
    &got,
    200 / portTICK_PERIOD_MS
  );

  int n = got / sizeof(int32_t);

  if (n == 0)
    return NAN;

  double mean = 0;

  for (int i = 0; i < n; i++) {
    mean += (i2sBuf[i] >> 8);
  }

  mean /= n;

  double sum = 0;

  for (int i = 0; i < n; i++) {

    double v =
      (i2sBuf[i] >> 8) - mean;

    sum += v * v;
  }

  double rms =
    sqrt(sum / n);

  if (rms < 1)
    rms = 1;

  double dbfs =
    20.0 *
    log10(
      rms / 8388608.0
    );

  return (float)(
    dbfs -
    MIC_REF_DBFS +
    MIC_OFFSET_DB
  );
}


// =========================
// SETUP
// =========================

void setup() {

  Serial.begin(115200);

  delay(300);

  // BME680
  Wire.begin(
    PIN_SDA,
    PIN_SCL
  );

  bmeFound =
    bme.begin(0x76) ||
    bme.begin(0x77);

  if (bmeFound) {

    bme.setTemperatureOversampling(
      BME680_OS_8X
    );

    bme.setHumidityOversampling(
      BME680_OS_2X
    );

    bme.setPressureOversampling(
      BME680_OS_4X
    );

    bme.setIIRFilterSize(
      BME680_FILTER_SIZE_3
    );

    bme.setGasHeater(
      320,
      150
    );

  } else {

    Serial.println(
      "{\"error\":\"BME680 not found\"}"
    );
  }


  // INMP441
  setupMic();


  // UART2 → Heltec #1
  // ESP32 RX = GPIO33
  // ESP32 TX = GPIO25

  LoRaSerial.begin(
    115200,
    SERIAL_8N1,
    33,
    25
  );


  Serial.println(
    "{\"status\":\"air node ready\"}"
  );
}


// =========================
// MAIN LOOP
// =========================

void loop() {

  static unsigned long last = 0;

  if (
    millis() - last <
    SAMPLE_MS
  ) {
    return;
  }

  last = millis();


  // -------------------------
  // BME680
  // -------------------------

  bool bmeOk =
    bmeFound &&
    bme.performReading();

  float tC =
    bmeOk ?
    bme.temperature :
    NAN;

  float rh =
    bmeOk ?
    bme.humidity :
    NAN;

  float hPa =
    bmeOk ?
    bme.pressure / 100.0f :
    NAN;

  float gasK =
    bmeOk ?
    bme.gas_resistance / 1000.0f :
    NAN;


  float altM =
    bmeOk ?
    44330.0f *
    (
      1.0f -
      powf(
        hPa /
        SEA_LEVEL_HPA,
        0.1903f
      )
    ) :
    NAN;


  float voc =
    bmeOk ?
    constrain(
      500.0f -
      (
        gasK - 10.0f
      ) *
      (
        500.0f /
        490.0f
      ),
      0.0f,
      500.0f
    ) :
    NAN;


  // -------------------------
  // INMP441
  // -------------------------

  float dB =
    readNoiseDb();


  // -------------------------
  // CREATE JSON
  // -------------------------

  StaticJsonDocument<320> doc;

  doc["nodeId"] =
    NODE_ID;

  doc["uptime_s"] =
    millis() / 1000;

  doc["temperature"] =
    serialized(
      String(tC, 1)
    );

  doc["humidity"] =
    serialized(
      String(rh, 0)
    );

  doc["pressure"] =
    serialized(
      String(hPa, 1)
    );

  doc["altitude_m"] =
    serialized(
      String(altM, 0)
    );

  doc["gas_kohm"] =
    serialized(
      String(gasK, 1)
    );

  doc["voc"] =
    serialized(
      String(voc, 0)
    );

  doc["noise"] =
    serialized(
      String(dB, 1)
    );


  // -------------------------
  // SENSOR HEALTH
  // -------------------------

  JsonObject health =
    doc.createNestedObject(
      "health"
    );

  health["bme680"] =
    bmeOk ?
    "online" :
    "offline";

  health["noise"] =
    isnan(dB) ?
    "offline" :
    "online";


  // -------------------------
  // SEND TO USB SERIAL
  // -------------------------

  serializeJson(
    doc,
    Serial
  );

  Serial.println();


  // -------------------------
  // SEND TO HELTEC #1
  // -------------------------

  serializeJson(
    doc,
    LoRaSerial
  );

  LoRaSerial.println();
}
